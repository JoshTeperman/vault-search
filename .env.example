# Placeholders only. Copy to .env (or /etc/vault-search/env on the VPS) and fill in
# locally. Never commit a filled-in file. Use the real MagicDNS name only on the box.

VAULT_ROOT=
# VAULT_PATH=
INDEX_PATH=
INDEX_INCLUDE_RAW=0
EMBEDDING_MODEL_PATH=
AUDIT_LOG_PATH=
DENYLIST_PATH=
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8787
MCP_PATH=/vault/mcp
PUBLIC_BASE_URL=https://<vps>.<tailnet>.ts.net
IDENTITY_SOURCE=whois
TAILSCALED_SOCKET=/var/run/tailscale/tailscaled.sock
