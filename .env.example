# Placeholders only. Copy to .env (or /etc/vault-search/env on the VPS) and fill in
# locally. Never commit a filled-in file. Use the real MagicDNS name only on the box.

VAULT_ROOT=
# VAULT_PATH=
INDEX_PATH=
INDEX_INCLUDE_RAW=0
INDEX_INCLUDE_EXAMPLES=0

# Unused for the v1 keyword-only deploy. Set these only when enabling semantic
# search later (pip install '.[semantic]' and reindex). See DEPLOY.md.
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_CACHE_DIR=
# EMBEDDING_MODEL_PATH=

AUDIT_LOG_PATH=
# Comma-separated node names, tags, or logins, and/or a file with one entry per line.
DENYLIST=
DENYLIST_PATH=

LISTEN_HOST=127.0.0.1
LISTEN_PORT=8787
MCP_PATH=/vault/mcp
# Required to bind 0.0.0.0 / :: — leave unset in production.
# LISTEN_ALLOW_NONLOCAL=0
PUBLIC_BASE_URL=https://<vps>.<tailnet>.ts.net
IDENTITY_SOURCE=whois
TAILSCALED_SOCKET=/var/run/tailscale/tailscaled.sock
